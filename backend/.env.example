# ============ 应用配置 ============
APP_NAME=资料资源下载器
APP_DEBUG=false
APP_ENV=production
APP_URL=http://ziliaoku.local:9901

# ============ 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ziliaoku
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# ============ JWT 鉴权 ============
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE=7200

# ============ 微信小程序配置 ============
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# ============ 微信支付配置 ============
WX_MCH_ID=your_mch_id_here
WX_API_KEY=your_api_key_here
WX_NOTIFY_URL=https://yourdomain.com/api/pay/notify
WX_CERT_PATH=E:/ziliaoku/backend/certs/apiclient_cert.pem
WX_KEY_PATH=E:/ziliaoku/backend/certs/apiclient_key.pem

# ============ 上传配置 ============
UPLOAD_PATH=E:/ziliaoku/backend/uploads
UPLOAD_MAX_SIZE=104857600
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,7z,mp3,mp4

# ============ 缓存配置 ============
CACHE_DRIVER=file
CACHE_PATH=E:/ziliaoku/runtime/cache
CACHE_TTL=3600

# ============ 日志配置 ============
LOG_LEVEL=warning
LOG_PATH=E:/ziliaoku/runtime/logs

# ============ Session 配置 ============
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_PATH=E:/ziliaoku/runtime/sessions
