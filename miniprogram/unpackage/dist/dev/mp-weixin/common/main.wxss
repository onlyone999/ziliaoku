page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;

  /* 主题变量（默认绿，运行时被 JS 覆盖） */
  --c-primary: #2ed573;
  --c-primary-dark: #27ae60;
  --c-primary-light: #3be88a;
  --c-accent: #1abc9c;
  --c-gradient-start: #26c67a;
  --c-gradient-end: #1abc9c;
  --c-rgb-primary: 46,213,115;
  --c-rgb-accent: 26,188,156;
  --c-tint-light: #f0fdf4;
  --c-tint-medium: #d1fae5;
  --c-tint-strong: #a7f3d0;
}
view, text, image, navigator, button, input, textarea {
  box-sizing: border-box;
}
button::after {
  border: none;
}
.container {
  padding: 20rpx;
}
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

