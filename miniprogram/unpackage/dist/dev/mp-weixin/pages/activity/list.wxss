
.page.data-v-c18d8616 {
	min-height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
}

/* ===== 分类标签 ===== */
.tabs-bar.data-v-c18d8616 {
	display: flex;
	background: rgba(255, 255, 255, 0.85);
	backdrop-filter: blur(20rpx);
	-webkit-backdrop-filter: blur(20rpx);
	padding: 20rpx 24rpx;
	gap: 16rpx;
	position: -webkit-sticky;
	position: sticky;
	top: 0;
	z-index: 10;
	box-shadow: 0 4rpx 20rpx rgba(46,213,115, 0.06);
}
.tab-item.data-v-c18d8616 {
	flex: 1;
	text-align: center;
	padding: 16rpx 0;
	border-radius: 36rpx;
	font-size: 26rpx;
	color: #888;
	background: #f0f1f8;
	transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
	position: relative;
}
.tab-item.active.data-v-c18d8616 {
	background: linear-gradient(135deg, #2ed573 0%, #27ae60 100%);
	color: #fff;
	font-weight: 700;
	box-shadow: 0 6rpx 24rpx rgba(46,213,115, 0.35);
	-webkit-transform: scale(1.02);
	        transform: scale(1.02);
}

/* ===== 列表滚动区 ===== */
.list-scroll.data-v-c18d8616 {
	height: calc(100vh - 100rpx);
}

/* ===== 骨架屏 ===== */
.skeleton-list.data-v-c18d8616 {
	padding: 24rpx;
}
.skeleton-card.data-v-c18d8616 {
	background: #fff;
	border-radius: 24rpx;
	overflow: hidden;
	margin-bottom: 24rpx;
	box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}
.skeleton-cover.data-v-c18d8616 {
	height: 300rpx;
	background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
	background-size: 200% 100%;
	-webkit-animation: shimmer-data-v-c18d8616 1.5s infinite;
	        animation: shimmer-data-v-c18d8616 1.5s infinite;
}
.skeleton-body.data-v-c18d8616 {
	padding: 24rpx;
}
.skeleton-line.data-v-c18d8616 {
	height: 28rpx;
	background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
	background-size: 200% 100%;
	-webkit-animation: shimmer-data-v-c18d8616 1.5s infinite;
	        animation: shimmer-data-v-c18d8616 1.5s infinite;
	border-radius: 10rpx;
	margin-bottom: 16rpx;
}
.skeleton-line.w80.data-v-c18d8616 { width: 80%;
}
.skeleton-line.w60.data-v-c18d8616 { width: 60%;
}
.skeleton-line.w40.data-v-c18d8616 { width: 40%;
}
@-webkit-keyframes shimmer-data-v-c18d8616 {
0% { background-position: 200% 0;
}
100% { background-position: -200% 0;
}
}
@keyframes shimmer-data-v-c18d8616 {
0% { background-position: 200% 0;
}
100% { background-position: -200% 0;
}
}

/* ===== 活动卡片 ===== */
.activity-list.data-v-c18d8616 {
	padding: 24rpx;
}
.activity-card.data-v-c18d8616 {
	background: #fff;
	border-radius: 24rpx;
	overflow: hidden;
	margin-bottom: 28rpx;
	box-shadow: 0 8rpx 32rpx rgba(46,213,115, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
	transition: box-shadow 0.25s ease, -webkit-transform 0.25s ease;
	transition: transform 0.25s ease, box-shadow 0.25s ease;
	transition: transform 0.25s ease, box-shadow 0.25s ease, -webkit-transform 0.25s ease;
	position: relative;
}

/* 顶部渐变装饰线 */
.activity-card.data-v-c18d8616::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 2rpx;
	background: linear-gradient(90deg, #2ed573, #27ae60, #1abc9c);
	border-radius: 2rpx 2rpx 0 0;
	z-index: 5;
	box-shadow: 0 0 6rpx rgba(46,213,115, 0.25);
}
.activity-card.data-v-c18d8616:active {
	-webkit-transform: scale(0.985);
	        transform: scale(0.985);
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.12);
}

/* 封面区域 */
.card-cover.data-v-c18d8616 {
	position: relative;
	height: 320rpx;
	overflow: hidden;
}
.cover-img.data-v-c18d8616 {
	width: 100%;
	height: 100%;
	transition: -webkit-transform 0.4s ease;
	transition: transform 0.4s ease;
	transition: transform 0.4s ease, -webkit-transform 0.4s ease;
}
.activity-card:active .cover-img.data-v-c18d8616 {
	-webkit-transform: scale(1.02);
	        transform: scale(1.02);
}

/* 封面渐变遮罩 - 底部向上 */
.card-cover.data-v-c18d8616::after {
	content: '';
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 60%;
	background: linear-gradient(transparent, rgba(0, 0, 0, 0.15));
	pointer-events: none;
}

/* 类型标签 + 发光 */
.type-tag.data-v-c18d8616 {
	position: absolute;
	top: 20rpx;
	left: 20rpx;
	padding: 8rpx 22rpx;
	border-radius: 24rpx;
	font-size: 22rpx;
	color: #fff;
	background: linear-gradient(135deg, #2ed573, #27ae60);
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.4), 0 0 20rpx rgba(46,213,115, 0.2);
	-webkit-animation: tagGlow-data-v-c18d8616 2s ease-in-out infinite alternate;
	        animation: tagGlow-data-v-c18d8616 2s ease-in-out infinite alternate;
}
.type-tag.offline.data-v-c18d8616 {
	background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
	box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.4), 0 0 20rpx rgba(255, 107, 107, 0.2);
}
.type-tag.both.data-v-c18d8616 {
	background: linear-gradient(135deg, #2ed573, #3be88a);
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.4), 0 0 20rpx rgba(46,213,115, 0.2);
}
@-webkit-keyframes tagGlow-data-v-c18d8616 {
0% { -webkit-filter: brightness(1); filter: brightness(1);
}
100% { -webkit-filter: brightness(1.15); filter: brightness(1.15);
}
}
@keyframes tagGlow-data-v-c18d8616 {
0% { -webkit-filter: brightness(1); filter: brightness(1);
}
100% { -webkit-filter: brightness(1.15); filter: brightness(1.15);
}
}
.signed-tag.data-v-c18d8616 {
	position: absolute;
	top: 20rpx;
	right: 20rpx;
	padding: 8rpx 22rpx;
	border-radius: 24rpx;
	font-size: 22rpx;
	color: #fff;
	background: linear-gradient(135deg, #2ed573, #3be88a);
	box-shadow: 0 4rpx 14rpx rgba(46,213,115, 0.35), 0 0 16rpx rgba(46,213,115, 0.15);
}

/* ===== 卡片内容 ===== */
.card-body.data-v-c18d8616 {
	padding: 26rpx;
}
.card-title.data-v-c18d8616 {
	font-size: 32rpx;
	font-weight: 700;
	color: #1a1a2e;
	display: block;
	margin-bottom: 16rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.card-info.data-v-c18d8616 {
	display: flex;
	align-items: center;
	margin-bottom: 10rpx;
}
.info-icon.data-v-c18d8616 {
	font-size: 26rpx;
	margin-right: 10rpx;
}
.info-text.data-v-c18d8616 {
	font-size: 24rpx;
	color: #999;
}

/* ===== 卡片底部 ===== */
.card-footer.data-v-c18d8616 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-top: 16rpx;
	padding-top: 16rpx;
	border-top: 1rpx solid rgba(46,213,115, 0.06);
}
.progress-info.data-v-c18d8616 {
	flex: 1;
}
.count-text.data-v-c18d8616 {
	font-size: 24rpx;
	color: #888;
	margin-bottom: 6rpx;
	display: block;
}
.mini-progress.data-v-c18d8616 {
	width: 160rpx;
	height: 10rpx;
	background: rgba(46,213,115, 0.08);
	border-radius: 10rpx;
	overflow: hidden;
	position: relative;
}
.mini-progress-bar.data-v-c18d8616 {
	height: 100%;
	background: linear-gradient(90deg, #2ed573, #27ae60);
	border-radius: 10rpx;
	transition: width 0.5s ease;
	box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.3);
	position: relative;
}

/* 进度条光泽扫过效果 */
.mini-progress-bar.data-v-c18d8616::after {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 25%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
	-webkit-animation: progressShine-data-v-c18d8616 5s ease-in-out infinite;
	        animation: progressShine-data-v-c18d8616 5s ease-in-out infinite;
}
@-webkit-keyframes progressShine-data-v-c18d8616 {
0% { left: -100%;
}
100% { left: 100%;
}
}
@keyframes progressShine-data-v-c18d8616 {
0% { left: -100%;
}
100% { left: 100%;
}
}
.status-badge.data-v-c18d8616 {
	padding: 6rpx 20rpx;
	border-radius: 24rpx;
	font-size: 22rpx;
	font-weight: 600;
}
.status-badge.open.data-v-c18d8616 {
	background: rgba(46,213,115, 0.1);
	box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.12), 0 0 12rpx rgba(46,213,115, 0.06);
}
.status-badge.full.data-v-c18d8616 {
	color: #ff6b6b;
	background: rgba(255, 107, 107, 0.1);
	box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.12), 0 0 12rpx rgba(255, 107, 107, 0.06);
}
.status-badge.deadline.data-v-c18d8616 {
	color: #999;
	background: rgba(153, 153, 153, 0.1);
	box-shadow: 0 2rpx 8rpx rgba(153, 153, 153, 0.08);
}

/* ===== 空状态 ===== */
.empty-state.data-v-c18d8616 {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 0;
	position: relative;
}
.empty-state.data-v-c18d8616::before {
