
.page.data-v-57875a19 {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
	overflow: hidden;
}

/* 分类头部 */
.cat-header.data-v-57875a19 {
	padding: 40rpx 30rpx 30rpx;
	position: relative;
	overflow: hidden;
	flex-shrink: 0;
}
.cat-header.data-v-57875a19::after {
	content: '';
	position: absolute;
	top: -60rpx;
	right: -60rpx;
	width: 200rpx;
	height: 200rpx;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.1);
}

/* 分类头部装饰粒子效果 */
.cat-header.data-v-57875a19::before {
	content: '';
	position: absolute;
	top: 20rpx;
	right: 80rpx;
	width: 8rpx;
	height: 8rpx;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.6);
	box-shadow:
		40rpx -10rpx 0 2rpx rgba(255, 255, 255, 0.3),
		80rpx 30rpx 0 1rpx rgba(255, 255, 255, 0.5),
		120rpx -20rpx 0 3rpx rgba(255, 255, 255, 0.2),
		200rpx 50rpx 0 2rpx rgba(255, 255, 255, 0.4),
		160rpx 80rpx 0 1rpx rgba(255, 255, 255, 0.3),
		60rpx 70rpx 0 2rpx rgba(255, 255, 255, 0.25),
		260rpx 20rpx 0 1rpx rgba(255, 255, 255, 0.35);
	-webkit-animation: particleFloat-data-v-57875a19 4s ease-in-out infinite;
	        animation: particleFloat-data-v-57875a19 4s ease-in-out infinite;
	z-index: 0;
}
@-webkit-keyframes particleFloat-data-v-57875a19 {
0%, 100% { -webkit-transform: translateY(0) scale(1); transform: translateY(0) scale(1); opacity: 0.7;
}
25% { -webkit-transform: translateY(-6rpx) scale(1.1); transform: translateY(-6rpx) scale(1.1); opacity: 1;
}
50% { -webkit-transform: translateY(4rpx) scale(0.95); transform: translateY(4rpx) scale(0.95); opacity: 0.8;
}
75% { -webkit-transform: translateY(-3rpx) scale(1.05); transform: translateY(-3rpx) scale(1.05); opacity: 0.9;
}
}
@keyframes particleFloat-data-v-57875a19 {
0%, 100% { -webkit-transform: translateY(0) scale(1); transform: translateY(0) scale(1); opacity: 0.7;
}
25% { -webkit-transform: translateY(-6rpx) scale(1.1); transform: translateY(-6rpx) scale(1.1); opacity: 1;
}
50% { -webkit-transform: translateY(4rpx) scale(0.95); transform: translateY(4rpx) scale(0.95); opacity: 0.8;
}
75% { -webkit-transform: translateY(-3rpx) scale(1.05); transform: translateY(-3rpx) scale(1.05); opacity: 0.9;
}
}
