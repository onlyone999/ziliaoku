




























































































































































































/* ===== 页面基础 ===== */
.page.data-v-f34175c0 {
	min-height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
}
.main-scroll.data-v-f34175c0 {
	height: 100vh;
}
/* ===== 表单区块 ===== */
.form-section.data-v-f34175c0 {
	margin: 24rpx;
	background: #fff;
	border-radius: 24rpx;
	padding: 28rpx 30rpx;
	box-shadow: 0 8rpx 32rpx rgba(46,213,115, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
	position: relative;
}
/* 顶部渐变装饰线 */
.form-section.data-v-f34175c0::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 2rpx;
	background: linear-gradient(90deg, #2ed573, #27ae60, #1abc9c);
	border-radius: 2rpx 2rpx 0 0;
	z-index: 2;
	opacity: 0.4;
}
.form-label.data-v-f34175c0 {
	font-size: 28rpx;
	font-weight: 600;
	color: #1a1a2e;
	margin-bottom: 20rpx;
	display: block;
}
/* ===== 类型选择 ===== */
.type-grid.data-v-f34175c0 {
	display: flex;
	gap: 16rpx;
}
.type-item.data-v-f34175c0 {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 24rpx 0;
	background: linear-gradient(135deg, #f8f9fe, #f0f2ff);
	border-radius: 20rpx;
	border: 2rpx solid transparent;
	transition: all 0.3s ease;
}
.type-item.active.data-v-f34175c0 {
	background: linear-gradient(135deg, rgba(46,213,115, 0.1), rgba(145, 228, 50, 0.06));
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.15);
}
.type-icon.data-v-f34175c0 {
	font-size: 44rpx;
	margin-bottom: 8rpx;
}
.type-name.data-v-f34175c0 {
	font-size: 24rpx;
	color: #666;
}
.type-item.active .type-name.data-v-f34175c0 {
	background: linear-gradient(135deg, #2ed573, #1abc9c);
	font-weight: 600;
}
/* ===== 文本域 - focus态 ===== */
.textarea-wrap.data-v-f34175c0 {
	position: relative;
}
.form-textarea.data-v-f34175c0 {
	width: 100%;
	height: 300rpx;
	font-size: 28rpx;
	color: #1a1a2e;
	padding: 20rpx;
	background: #f8f9fe;
	border-radius: 20rpx;
	box-sizing: border-box;
	line-height: 1.6;
	border: 2rpx solid transparent;
	transition: all 0.3s ease;
}
.form-textarea.data-v-f34175c0:focus {
	background: #fff;
	border-color: rgba(46,213,115, 0.3);
	box-shadow: 0 0 0 4rpx rgba(46,213,115, 0.08), 0 4rpx 16rpx rgba(46,213,115, 0.06);
}
.char-count.data-v-f34175c0 {
	position: absolute;
	bottom: 16rpx;
	right: 20rpx;
	font-size: 22rpx;
	color: #bbb;
}
/* ===== 输入框 - focus态 ===== */
.form-input.data-v-f34175c0 {
	height: 80rpx;
	font-size: 28rpx;
	color: #1a1a2e;
	padding: 0 24rpx;
	background: #f8f9fe;
	border-radius: 20rpx;
	border: 2rpx solid transparent;
	transition: all 0.3s ease;
}
.form-input.data-v-f34175c0:focus {
	background: #fff;
	border-color: rgba(46,213,115, 0.3);
	box-shadow: 0 0 0 4rpx rgba(46,213,115, 0.08), 0 4rpx 16rpx rgba(46,213,115, 0.06);
}
/* ===== 提交按钮 ===== */
.submit-area.data-v-f34175c0 {
	margin: 40rpx 24rpx;
}
.submit-btn.data-v-f34175c0 {
	background: linear-gradient(135deg, #2ed573, #5A52D5, #1abc9c);
	text-align: center;
	padding: 26rpx;
	border-radius: 44rpx;
	font-size: 30rpx;
	font-weight: 600;
	color: #fff;
	box-shadow: 0 8rpx 28rpx rgba(46,213,115, 0.35);
	transition: all 0.3s ease;
	letter-spacing: 2rpx;
	position: relative;
	overflow: hidden;
}
/* shimmer扫光 */
.submit-btn.data-v-f34175c0::after {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 60%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
	-webkit-animation: btnShimmer-data-v-f34175c0 5s ease-in-out infinite;
	        animation: btnShimmer-data-v-f34175c0 5s ease-in-out infinite;
}
@-webkit-keyframes btnShimmer-data-v-f34175c0 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
@keyframes btnShimmer-data-v-f34175c0 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
.submit-btn.data-v-f34175c0:active {
	-webkit-transform: scale(0.97);
	        transform: scale(0.97);
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.4);
}
.submit-btn.disabled.data-v-f34175c0 {
	opacity: 0.5;
	box-shadow: none;
}
