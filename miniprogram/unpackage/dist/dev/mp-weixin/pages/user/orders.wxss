












































































































































































































































































































































/* ===== 页面基础 ===== */
.page.data-v-53badd80 {
	min-height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
	display: flex;
	flex-direction: column;
}
/* ===== 标签栏 ===== */
.tabs-bar.data-v-53badd80 {
	display: flex;
	background: #fff;
	padding: 0 12rpx;
	flex-shrink: 0;
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.06);
	position: relative;
}
/* Tab栏底部光晕 */
.tabs-bar.data-v-53badd80::after {
	content: '';
	position: absolute;
	bottom: -6rpx;
	left: 15%;
	right: 15%;
	height: 12rpx;
	background: linear-gradient(90deg, transparent, rgba(46,213,115, 0.12), transparent);
	border-radius: 50%;
	-webkit-filter: blur(6rpx);
	        filter: blur(6rpx);
}
.tab-item.data-v-53badd80 {
	flex: 1;
	text-align: center;
	padding: 28rpx 0;
	font-size: 26rpx;
	color: #888;
	position: relative;
	transition: color 0.3s ease;
}
.tab-item.active.data-v-53badd80 {
	font-weight: 700;
}
.tab-item.active.data-v-53badd80::after {
	content: '';
	position: absolute;
	bottom: 0;
	left: 50%;
	-webkit-transform: translateX(-50%);
	        transform: translateX(-50%);
	width: 56rpx;
	height: 6rpx;
	background: linear-gradient(135deg, #2ed573, #1abc9c);
	border-radius: 3rpx;
	box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.3);
}
.list-scroll.data-v-53badd80 {
	flex: 1;
}
/* ===== 订单列表 ===== */
.order-list.data-v-53badd80 {
	padding: 16rpx 24rpx;
}
.order-card.data-v-53badd80 {
	background: #fff;
	border-radius: 24rpx;
	margin-bottom: 20rpx;
	overflow: hidden;
	box-shadow: 0 8rpx 32rpx rgba(46,213,115, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
	transition: -webkit-transform 0.2s ease;
	transition: transform 0.2s ease;
	transition: transform 0.2s ease, -webkit-transform 0.2s ease;
	position: relative;
}
/* 顶部渐变装饰线 */
.order-card.data-v-53badd80::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 2rpx;
	background: linear-gradient(90deg, #2ed573, #27ae60, #1abc9c);
	border-radius: 2rpx 2rpx 0 0;
	z-index: 2;
	box-shadow: 0 0 6rpx rgba(46,213,115, 0.25);
}
.order-card.data-v-53badd80:active {
	-webkit-transform: scale(0.985);
	        transform: scale(0.985);
}
.order-header.data-v-53badd80 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx 24rpx;
	border-bottom: 1rpx solid rgba(46,213,115, 0.06);
}
.order-no.data-v-53badd80 {
	font-size: 24rpx;
	color: #aaa;
}
.order-status-badge.data-v-53badd80 {
	padding: 6rpx 18rpx;
	border-radius: 20rpx;
	font-size: 22rpx;
	font-weight: 600;
}
/* 待支付脉冲 */
.order-status-badge.pending.data-v-53badd80 {
	color: #ff9f43;
	background: linear-gradient(135deg, rgba(255, 159, 67, 0.14), rgba(255, 159, 67, 0.06));
	box-shadow: 0 2rpx 4rpx rgba(255, 159, 67, 0.15);
	-webkit-animation: pulse-orange-data-v-53badd80 2s ease-in-out infinite;
	        animation: pulse-orange-data-v-53badd80 2s ease-in-out infinite;
}
@-webkit-keyframes pulse-orange-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(255, 159, 67, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(255, 159, 67, 0.35), 0 0 6rpx rgba(255, 159, 67, 0.15);
}
}
@keyframes pulse-orange-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(255, 159, 67, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(255, 159, 67, 0.35), 0 0 6rpx rgba(255, 159, 67, 0.15);
}
}
/* 已完成脉冲 */
.order-status-badge.paid.data-v-53badd80 {
	background: linear-gradient(135deg, rgba(46,213,115, 0.14), rgba(46,213,115, 0.06));
	box-shadow: 0 2rpx 4rpx rgba(46,213,115, 0.15);
	-webkit-animation: pulse-green-data-v-53badd80 2s ease-in-out infinite;
	        animation: pulse-green-data-v-53badd80 2s ease-in-out infinite;
}
@-webkit-keyframes pulse-green-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(46,213,115, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.35), 0 0 6rpx rgba(46,213,115, 0.15);
}
}
@keyframes pulse-green-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(46,213,115, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.35), 0 0 6rpx rgba(46,213,115, 0.15);
}
}
.order-status-badge.cancelled.data-v-53badd80 {
	color: #999;
	background: linear-gradient(135deg, rgba(153, 153, 153, 0.14), rgba(153, 153, 153, 0.06));
	box-shadow: 0 2rpx 8rpx rgba(153, 153, 153, 0.1);
}
.order-status-badge.refunded.data-v-53badd80 {
	color: #ff4757;
	background: linear-gradient(135deg, rgba(255, 71, 87, 0.14), rgba(255, 71, 87, 0.06));
	box-shadow: 0 2rpx 4rpx rgba(255, 71, 87, 0.15);
	-webkit-animation: pulse-red-data-v-53badd80 2s ease-in-out infinite;
	        animation: pulse-red-data-v-53badd80 2s ease-in-out infinite;
}
@-webkit-keyframes pulse-red-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(255, 71, 87, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.35), 0 0 6rpx rgba(255, 71, 87, 0.15);
}
}
@keyframes pulse-red-data-v-53badd80 {
0%, 100% { box-shadow: 0 2rpx 4rpx rgba(255, 71, 87, 0.15);
}
50% { box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.35), 0 0 6rpx rgba(255, 71, 87, 0.15);
}
}
.order-body.data-v-53badd80 {
	display: flex;
	padding: 20rpx 24rpx;
}
.order-cover.data-v-53badd80 {
	width: 160rpx;
	height: 120rpx;
	border-radius: 12rpx;
	flex-shrink: 0;
	transition: -webkit-transform 0.4s ease;
	transition: transform 0.4s ease;
	transition: transform 0.4s ease, -webkit-transform 0.4s ease;
}
.order-card:active .order-cover.data-v-53badd80 {
	-webkit-transform: scale(1.02);
	        transform: scale(1.02);
}
.order-info.data-v-53badd80 {
	flex: 1;
	margin-left: 20rpx;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.order-title.data-v-53badd80 {
	font-size: 28rpx;
	color: #1a1a2e;
	font-weight: 600;
	overflow: hidden;
	text-overflow: ellipsis;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	line-height: 1.5;
}
.order-meta.data-v-53badd80 {
	margin-top: 8rpx;
}
.order-time.data-v-53badd80 {
	font-size: 22rpx;
	color: #bbb;
}
.order-footer.data-v-53badd80 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 18rpx 24rpx;
	border-top: 1rpx solid rgba(46,213,115, 0.06);
}
.amount-row.data-v-53badd80 {
	display: flex;
	align-items: baseline;
	gap: 6rpx;
}
.amount-label.data-v-53badd80 {
	font-size: 24rpx;
	color: #aaa;
}
.order-amount.data-v-53badd80 {
	font-size: 34rpx;
	color: #ff4757;
	font-weight: 700;
}
.order-actions.data-v-53badd80 {
	display: flex;
	gap: 12rpx;
}
.action-btn.data-v-53badd80 {
	padding: 10rpx 28rpx;
	border-radius: 28rpx;
	font-size: 24rpx;
	font-weight: 500;
	transition: all 0.3s ease;
}
.action-btn.data-v-53badd80:active {
	-webkit-transform: scale(0.95);
	        transform: scale(0.95);
}
.pay-btn.data-v-53badd80 {
	background: linear-gradient(135deg, #ff4757, #ff6b81);
	color: #fff;
	box-shadow: 0 4rpx 16rpx rgba(255, 71, 87, 0.3);
	position: relative;
	overflow: hidden;
}
/* 支付按钮shimmer */
.pay-btn.data-v-53badd80::after {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 25%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
	-webkit-animation: btnShimmer-data-v-53badd80 5s ease-in-out infinite;
	        animation: btnShimmer-data-v-53badd80 5s ease-in-out infinite;
}
@-webkit-keyframes btnShimmer-data-v-53badd80 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
@keyframes btnShimmer-data-v-53badd80 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
.cancel-btn.data-v-53badd80 {
	background: linear-gradient(135deg, #f0f0f0, #e8e8e8);
	color: #888;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.download-btn.data-v-53badd80 {
	background: linear-gradient(135deg, #2ed573, #5A52D5);
	color: #fff;
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.3);
}
.detail-btn.data-v-53badd80 {
	background: linear-gradient(135deg, #f0eeff, #e8e5ff);
	box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.08);
}
/* ===== 空状态 ===== */
.empty.data-v-53badd80 {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 120rpx 0;
	position: relative;
}
.empty.data-v-53badd80::before {
	content: '';
	position: absolute;
	top: 40rpx;
	width: 320rpx;
	height: 320rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, rgba(46,213,115, 0.06), rgba(255, 159, 67, 0.06));
	-webkit-filter: blur(2rpx);
	        filter: blur(2rpx);
}
.empty-icon.data-v-53badd80 {
	font-size: 120rpx;
	margin-bottom: 32rpx;
	position: relative;
	z-index: 1;
	-webkit-animation: breathe-data-v-53badd80 3s ease-in-out infinite;
	        animation: breathe-data-v-53badd80 3s ease-in-out infinite;
}
@-webkit-keyframes breathe-data-v-53badd80 {
0%, 100% { -webkit-transform: scale(1); transform: scale(1);
}
50% { -webkit-transform: scale(1.04); transform: scale(1.04);
}
}
@keyframes breathe-data-v-53badd80 {
0%, 100% { -webkit-transform: scale(1); transform: scale(1);
}
50% { -webkit-transform: scale(1.04); transform: scale(1.04);
}
}
.empty-title.data-v-53badd80 {
	font-size: 34rpx;
	color: #1a1a2e;
	font-weight: 700;
	margin-bottom: 12rpx;
	position: relative;
	z-index: 1;
}
.empty-desc.data-v-53badd80 {
	font-size: 26rpx;
	color: #aaa;
	position: relative;
	z-index: 1;
}
/* ===== 加载状态 ===== */
.load-status.data-v-53badd80 {
	text-align: center;
	padding: 30rpx 0;
	font-size: 24rpx;
	color: #aaa;
}
.load-status text.data-v-53badd80:first-child {
	display: inline-block;
	-webkit-animation: pulse-text-data-v-53badd80 1.4s ease-in-out infinite;
	        animation: pulse-text-data-v-53badd80 1.4s ease-in-out infinite;
}
@-webkit-keyframes pulse-text-data-v-53badd80 {
0%, 100% { opacity: 0.4;
}
50% { opacity: 1;
}
}
@keyframes pulse-text-data-v-53badd80 {
0%, 100% { opacity: 0.4;
}
50% { opacity: 1;
}
}

