}
.info-item.data-v-1b80cabc:last-child {
	border-bottom: none;
}
.info-label.data-v-1b80cabc {
	font-size: 26rpx;
	color: #aaa;
}
.info-value.data-v-1b80cabc {
	font-size: 26rpx;
	color: #333;
	font-weight: 500;
}

/* ===== 底部栏 - 玻璃态 ===== */
.bottom-bar.data-v-1b80cabc {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	display: flex;
	padding: 16rpx 24rpx;
	padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
	background: rgba(255, 255, 255, 0.7);
	backdrop-filter: blur(40rpx) saturate(150%);
	-webkit-backdrop-filter: blur(40rpx) saturate(150%);
	box-shadow: 0 -4rpx 30rpx rgba(46,213,115, 0.06), 0 -1rpx 0 rgba(255, 255, 255, 0.5) inset;
	z-index: 100;
}
.btn-fav.data-v-1b80cabc {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	height: 84rpx;
	border-radius: 42rpx;
	background: rgba(46,213,115, 0.06);
	margin-right: 16rpx;
	font-size: 26rpx;
	color: #666;
	border: 1rpx solid rgba(46,213,115, 0.08);
	transition: all 0.2s ease;
}
.btn-fav.data-v-1b80cabc:active {
	background: rgba(46,213,115, 0.12);
	-webkit-transform: translateY(2rpx);
	        transform: translateY(2rpx);
}
.btn-download.data-v-1b80cabc {
	flex: 2;
	display: flex;
	align-items: center;
	justify-content: center;
	height: 84rpx;
	border-radius: 42rpx;
	background: linear-gradient(135deg, #2ed573 0%, #27ae60 100%);
	font-size: 28rpx;
	color: #fff;
	font-weight: 700;
	box-shadow: 0 8rpx 28rpx rgba(46,213,115, 0.3);
	transition: all 0.2s ease;
	position: relative;
	overflow: hidden;
}

/* 下载按钮shimmer */
.btn-download.data-v-1b80cabc::after {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 60%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
	-webkit-animation: btnShimmer-data-v-1b80cabc 5s ease-in-out infinite;
	        animation: btnShimmer-data-v-1b80cabc 5s ease-in-out infinite;
}
@-webkit-keyframes btnShimmer-data-v-1b80cabc {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
@keyframes btnShimmer-data-v-1b80cabc {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
.btn-download.data-v-1b80cabc:active {
	-webkit-transform: scale(0.97) translateY(2rpx);
	        transform: scale(0.97) translateY(2rpx);
	box-shadow: 0 4rpx 14rpx rgba(46,213,115, 0.2);
}

/* ===== 空状态 ===== */
.empty-wrap.data-v-1b80cabc {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 300rpx;
	position: relative;
}
.empty-wrap.data-v-1b80cabc::before {
	content: '';
	position: absolute;
	width: 240rpx;
	height: 240rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, rgba(46,213,115, 0.06), rgba(126, 217, 87, 0.03));
	top: 240rpx;
}
.empty-icon.data-v-1b80cabc {
	font-size: 80rpx;
	margin-bottom: 20rpx;
	position: relative;
	z-index: 1;
	-webkit-animation: breathe-data-v-1b80cabc 3s ease-in-out infinite;
	        animation: breathe-data-v-1b80cabc 3s ease-in-out infinite;
}
.empty-text.data-v-1b80cabc {
	font-size: 28rpx;
	color: #aaa;
	position: relative;
	z-index: 1;
}
@-webkit-keyframes breathe-data-v-1b80cabc {
0%, 100% { -webkit-transform: scale(1); transform: scale(1);
}
50% { -webkit-transform: scale(1.08); transform: scale(1.08);
}
}
@keyframes breathe-data-v-1b80cabc {
0%, 100% { -webkit-transform: scale(1); transform: scale(1);
}
50% { -webkit-transform: scale(1.08); transform: scale(1.08);
}
}

