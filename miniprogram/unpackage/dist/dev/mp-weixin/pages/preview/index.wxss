}
.category-badge.data-v-1b80cabc {
	font-size: 22rpx;

	background: rgba(46,213,115, 0.08);
	padding: 6rpx 20rpx;
	border-radius: 24rpx;
	font-weight: 500;
	box-shadow: 0 2rpx 8rpx rgba(46,213,115, 0.08);
}
.file-type.data-v-1b80cabc {
	font-size: 22rpx;
	color: #00b894;
	background: rgba(0, 184, 148, 0.08);
	padding: 6rpx 20rpx;
	border-radius: 24rpx;
	font-weight: 500;
	box-shadow: 0 2rpx 8rpx rgba(0, 184, 148, 0.08);
}
.desc.data-v-1b80cabc {
	margin-top: 20rpx;
	font-size: 26rpx;
