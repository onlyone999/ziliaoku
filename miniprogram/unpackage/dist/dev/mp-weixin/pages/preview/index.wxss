
.page.data-v-1b80cabc {
	min-height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
}

/* ===== 加载 ===== */
.loading-wrap.data-v-1b80cabc {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding-top: 300rpx;
}
.loading-spinner.data-v-1b80cabc {
	width: 64rpx;
	height: 64rpx;
	border: 4rpx solid rgba(46,213,115, 0.12);
	border-top-color: #2ed573;
	border-radius: 50%;
	-webkit-animation: spin-data-v-1b80cabc 0.8s linear infinite;
	        animation: spin-data-v-1b80cabc 0.8s linear infinite;
	box-shadow: 0 0 20rpx rgba(46,213,115, 0.15);
}
@-webkit-keyframes spin-data-v-1b80cabc {
to { -webkit-transform: rotate(360deg); transform: rotate(360deg);
}
}
@keyframes spin-data-v-1b80cabc {
to { -webkit-transform: rotate(360deg); transform: rotate(360deg);
}
}
.loading-text.data-v-1b80cabc {
	margin-top: 20rpx;
	font-size: 26rpx;
	color: #aaa;
}

/* ===== 预览图 ===== */
.preview-swiper.data-v-1b80cabc {
	width: 100%;
	height: 560rpx;
	background: #0a0a0a;
	position: relative;
}

/* 渐变边框装饰 */
.preview-swiper.data-v-1b80cabc::after {
	content: '';
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 1rpx;
	background: rgba(46,213,115,0.08);
	z-index: 5;
}
.preview-img.data-v-1b80cabc {
	width: 100%;
	height: 100%;
}

