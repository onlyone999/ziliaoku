<view class="page data-v-1b80cabc"><block wx:if="{{loading}}"><view class="loading-wrap data-v-1b80cabc"><view class="loading-spinner data-v-1b80cabc"></view><text class="loading-text data-v-1b80cabc">加载中...</text></view></block><block wx:else><block wx:if="{{resource}}"><view class="content data-v-1b80cabc"><swiper class="preview-swiper data-v-1b80cabc" indicator-dots="{{$root.g0>1}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff" circular="{{true}}"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="idx" wx:key="idx"><swiper-item class="data-v-1b80cabc"><image class="preview-img data-v-1b80cabc" src="{{img}}" mode="aspectFit" data-event-opts="{{[['tap',[['previewImage',[idx]]]]]}}" bindtap="__e"></image></swiper-item></block></swiper><view class="info-card data-v-1b80cabc"><text class="title data-v-1b80cabc">{{resource.title}}</text><view class="meta-row data-v-1b80cabc"><block wx:if="{{resource.category_name}}"><text class="category-badge data-v-1b80cabc" style="{{(tPri)}}">{{resource.category_name}}</text></block><block wx:if="{{resource.file_type}}"><text class="file-type data-v-1b80cabc" style="{{('color:'+tc.primary+';')}}">{{resource.file_type}}</text></block></view><block wx:if="{{resource.description}}"><view class="desc data-v-1b80cabc"><text class="data-v-1b80cabc">{{resource.description}}</text></view></block><view class="stats-row data-v-1b80cabc"><text class="stat data-v-1b80cabc">{{"👁 "+(resource.view_count||0)}}</text><text class="stat data-v-1b80cabc">{{"↓ "+(resource.download_count||0)}}</text><text class="stat data-v-1b80cabc">{{"❤ "+(resource.like_count||0)}}</text></view><block wx:if="{{resource.price>0}}"><view class="price-row data-v-1b80cabc"><text class="price data-v-1b80cabc">{{"¥"+resource.price}}</text><block wx:if="{{resource.original_price>resource.price}}"><text class="original-price data-v-1b80cabc">{{"¥"+resource.original_price}}</text></block></view></block><block wx:else><view class="price-row data-v-1b80cabc"><text class="free-tag data-v-1b80cabc" style="{{('color:'+tc.primary+';border-color:'+tc.primary+';')}}">免费</text></view></block></view><block wx:if="{{resource.file_size||resource.file_format}}"><view class="file-info-card data-v-1b80cabc"><text class="card-title data-v-1b80cabc">文件信息</text><block wx:if="{{resource.file_size}}"><view class="info-item data-v-1b80cabc"><text class="info-label data-v-1b80cabc">文件大小</text><text class="info-value data-v-1b80cabc">{{$root.m0}}</text></view></block><block wx:if="{{resource.file_format}}"><view class="info-item data-v-1b80cabc"><text class="info-label data-v-1b80cabc">文件格式</text><text class="info-value data-v-1b80cabc">{{resource.file_format}}</text></view></block><block wx:if="{{resource.file_count}}"><view class="info-item data-v-1b80cabc"><text class="info-label data-v-1b80cabc">文件数量</text><text class="info-value data-v-1b80cabc">{{resource.file_count+" 个"}}</text></view></block></view></block><view class="bottom-bar data-v-1b80cabc"><view data-event-opts="{{[['tap',[['toggleFavorite',['$event']]]]]}}" class="btn-fav data-v-1b80cabc" bindtap="__e"><text class="data-v-1b80cabc">{{isFav?'❤️ 已收藏':'🤍 收藏'}}</text></view><view data-event-opts="{{[['tap',[['goDownload',['$event']]]]]}}" class="btn-download data-v-1b80cabc" style="{{(resource.price<=0?'color:'+tc.primary+';border-color:'+tc.primary+';':'')}}" bindtap="__e"><text class="data-v-1b80cabc">{{resource.price>0?'¥'+resource.price+' 购买下载':'免费下载'}}</text></view></view></view></block><block wx:else><view class="empty-wrap data-v-1b80cabc"><text class="empty-icon data-v-1b80cabc">😕</text><text class="empty-text data-v-1b80cabc">资源不存在或已下架</text></view></block></block></view>