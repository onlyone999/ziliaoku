
.page.data-v-c3675ac6 {
	min-height: 100vh;
	background: linear-gradient(180deg, #f0f2ff 0%, #f5f6fa 200rpx);
	display: flex;
	align-items: center;
	justify-content: center;
}
.result-container.data-v-c3675ac6 {
	width: 100%;
	padding: 60rpx 40rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
}

/* ===== 状态图标 + 动画 ===== */
.status-icon.data-v-c3675ac6 {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 36rpx;
	position: relative;
}

/* 成功：呼吸灯 + 外环旋转 + 金色粒子散射 */
.status-icon.success.data-v-c3675ac6 {
	background: linear-gradient(135deg, #2ed573, #3be88a);
	box-shadow:
		0 8rpx 36rpx rgba(46,213,115, 0.35),
		0 0 60rpx rgba(255, 215, 0, 0.15),
		20rpx -30rpx 0 -14rpx rgba(255, 215, 0, 0.5),
		-25rpx -20rpx 0 -14rpx rgba(255, 200, 0, 0.4),
		30rpx 10rpx 0 -14rpx rgba(255, 180, 0, 0.35),
		-20rpx 25rpx 0 -14rpx rgba(255, 215, 0, 0.45);
	-webkit-animation: breatheSuccess-data-v-c3675ac6 2s ease-in-out infinite;
	        animation: breatheSuccess-data-v-c3675ac6 2s ease-in-out infinite;
}
.status-icon.success.data-v-c3675ac6::before {
	content: '';
	position: absolute;
	top: -12rpx;
	left: -12rpx;
	right: -12rpx;
	bottom: -12rpx;
	border-radius: 50%;
	border: 4rpx solid transparent;
	border-top-color: #2ed573;
	border-right-color: rgba(46,213,115, 0.4);
	-webkit-animation: ringRotate-data-v-c3675ac6 1.5s linear infinite;
	        animation: ringRotate-data-v-c3675ac6 1.5s linear infinite;
}
.status-icon.success.data-v-c3675ac6::after {
	content: '';
	position: absolute;
	top: -24rpx;
	left: -24rpx;
	right: -24rpx;
	bottom: -24rpx;
	border-radius: 50%;
	border: 2rpx solid transparent;
	border-bottom-color: rgba(123, 237, 159, 0.3);
	border-left-color: rgba(46,213,115, 0.15);
	animation: ringRotate-data-v-c3675ac6 2.5s linear infinite reverse;
}

/* 失败：闪烁 + 外环旋转 */
.status-icon.fail.data-v-c3675ac6 {
	background: linear-gradient(135deg, #ff4757, #ff6b81);
	box-shadow: 0 8rpx 36rpx rgba(255, 71, 87, 0.35);
	-webkit-animation: breatheFail-data-v-c3675ac6 2.5s ease-in-out infinite;
	        animation: breatheFail-data-v-c3675ac6 2.5s ease-in-out infinite;
}
.status-icon.fail.data-v-c3675ac6::before {
	content: '';
	position: absolute;
	top: -12rpx;
	left: -12rpx;
	right: -12rpx;
	bottom: -12rpx;
	border-radius: 50%;
	border: 4rpx solid transparent;
	border-top-color: #ff4757;
	border-right-color: rgba(255, 107, 129, 0.4);
	-webkit-animation: ringRotate-data-v-c3675ac6 1.5s linear infinite;
	        animation: ringRotate-data-v-c3675ac6 1.5s linear infinite;
}

/* 待定：脉冲旋转 */
.status-icon.pending.data-v-c3675ac6 {
	background: linear-gradient(135deg, #ff9f43, #feca57);
	box-shadow: 0 8rpx 36rpx rgba(255, 159, 67, 0.35);
	-webkit-animation: breathePending-data-v-c3675ac6 1.5s ease-in-out infinite;
	        animation: breathePending-data-v-c3675ac6 1.5s ease-in-out infinite;
}
.status-icon.pending.data-v-c3675ac6::before {
	content: '';
	position: absolute;
	top: -12rpx;
	left: -12rpx;
	right: -12rpx;
	bottom: -12rpx;
	border-radius: 50%;
	border: 4rpx solid transparent;
	border-top-color: #ff9f43;
	border-right-color: #feca57;
	-webkit-animation: ringRotate-data-v-c3675ac6 1s linear infinite;
	        animation: ringRotate-data-v-c3675ac6 1s linear infinite;
}
@-webkit-keyframes breatheSuccess-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(46,213,115, 0.3), 0 0 60rpx rgba(255, 215, 0, 0.1), 20rpx -30rpx 0 -14rpx rgba(255, 215, 0, 0.5), -25rpx -20rpx 0 -14rpx rgba(255, 200, 0, 0.4), 30rpx 10rpx 0 -14rpx rgba(255, 180, 0, 0.35), -20rpx 25rpx 0 -14rpx rgba(255, 215, 0, 0.45); -webkit-transform: scale(1); transform: scale(1);
}
50% { box-shadow: 0 12rpx 50rpx rgba(46,213,115, 0.5), 0 0 80rpx rgba(255, 215, 0, 0.25), 25rpx -38rpx 0 -12rpx rgba(255, 215, 0, 0.7), -30rpx -25rpx 0 -12rpx rgba(255, 200, 0, 0.6), 38rpx 14rpx 0 -12rpx rgba(255, 180, 0, 0.5), -25rpx 32rpx 0 -12rpx rgba(255, 215, 0, 0.6); -webkit-transform: scale(1.04); transform: scale(1.04);
}
}
@keyframes breatheSuccess-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(46,213,115, 0.3), 0 0 60rpx rgba(255, 215, 0, 0.1), 20rpx -30rpx 0 -14rpx rgba(255, 215, 0, 0.5), -25rpx -20rpx 0 -14rpx rgba(255, 200, 0, 0.4), 30rpx 10rpx 0 -14rpx rgba(255, 180, 0, 0.35), -20rpx 25rpx 0 -14rpx rgba(255, 215, 0, 0.45); -webkit-transform: scale(1); transform: scale(1);
}
50% { box-shadow: 0 12rpx 50rpx rgba(46,213,115, 0.5), 0 0 80rpx rgba(255, 215, 0, 0.25), 25rpx -38rpx 0 -12rpx rgba(255, 215, 0, 0.7), -30rpx -25rpx 0 -12rpx rgba(255, 200, 0, 0.6), 38rpx 14rpx 0 -12rpx rgba(255, 180, 0, 0.5), -25rpx 32rpx 0 -12rpx rgba(255, 215, 0, 0.6); -webkit-transform: scale(1.04); transform: scale(1.04);
}
}
@-webkit-keyframes breatheFail-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(255, 71, 87, 0.3); opacity: 1;
}
50% { box-shadow: 0 12rpx 50rpx rgba(255, 71, 87, 0.5); opacity: 0.85;
}
}
@keyframes breatheFail-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(255, 71, 87, 0.3); opacity: 1;
}
50% { box-shadow: 0 12rpx 50rpx rgba(255, 71, 87, 0.5); opacity: 0.85;
}
}
@-webkit-keyframes breathePending-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(255, 159, 67, 0.3); -webkit-transform: scale(1); transform: scale(1);
}
50% { box-shadow: 0 12rpx 50rpx rgba(255, 159, 67, 0.5); -webkit-transform: scale(1.06); transform: scale(1.06);
}
}
@keyframes breathePending-data-v-c3675ac6 {
0%, 100% { box-shadow: 0 8rpx 36rpx rgba(255, 159, 67, 0.3); -webkit-transform: scale(1); transform: scale(1);
}
50% { box-shadow: 0 12rpx 50rpx rgba(255, 159, 67, 0.5); -webkit-transform: scale(1.06); transform: scale(1.06);
}
}
@-webkit-keyframes ringRotate-data-v-c3675ac6 {
0% { -webkit-transform: rotate(0deg); transform: rotate(0deg);
}
100% { -webkit-transform: rotate(360deg); transform: rotate(360deg);
}
}
@keyframes ringRotate-data-v-c3675ac6 {
0% { -webkit-transform: rotate(0deg); transform: rotate(0deg);
}
100% { -webkit-transform: rotate(360deg); transform: rotate(360deg);
}
}
.icon-text.data-v-c3675ac6 {
	font-size: 64rpx;
	color: #fff;
	font-weight: 700;
	text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ===== 状态文字 ===== */
.status-title.data-v-c3675ac6 {
	font-size: 38rpx;
	font-weight: 700;
	color: #1a1a2e;
	margin-bottom: 12rpx;
}
.status-desc.data-v-c3675ac6 {
	font-size: 26rpx;
	color: #aaa;
	margin-bottom: 48rpx;
}

/* ===== 订单信息卡片 ===== */
.order-card.data-v-c3675ac6 {
	width: 100%;
	background: #fff;
	border-radius: 24rpx;
	padding: 32rpx;
	margin-bottom: 48rpx;
	box-shadow: 0 12rpx 40rpx rgba(46,213,115, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
	position: relative;
	overflow: hidden;
}

/* 卡片顶部装饰线 */
.order-card.data-v-c3675ac6::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 2rpx;
	background: linear-gradient(90deg, #2ed573, #27ae60, #2ed573);
	border-radius: 2rpx 2rpx 0 0;
	box-shadow: 0 0 6rpx rgba(46,213,115, 0.3);
}
.card-row.data-v-c3675ac6 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 16rpx 0;
	border-bottom: 1rpx solid rgba(46,213,115, 0.04);
	transition: background 0.2s ease;
}

/* 交替背景色 */
.card-row.data-v-c3675ac6:nth-child(odd) {
	background: rgba(46,213,115, 0.015);
	border-radius: 8rpx;
}
.card-row.data-v-c3675ac6:last-child {
	border-bottom: none;
}
.row-label.data-v-c3675ac6 {
	font-size: 26rpx;
	color: #aaa;
}
.row-value.data-v-c3675ac6 {
	font-size: 26rpx;
	color: #333;
	font-weight: 500;
}
.row-value.price.data-v-c3675ac6 {
	color: #ff4757;
	font-weight: 800;
	font-size: 32rpx;
}

/* ===== 操作按钮 ===== */
.action-area.data-v-c3675ac6 {
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}
.action-btn.data-v-c3675ac6 {
	text-align: center;
	padding: 28rpx;
	border-radius: 48rpx;
	font-size: 30rpx;
	font-weight: 700;
	transition: box-shadow 0.2s ease, -webkit-transform 0.2s ease;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
	transition: transform 0.2s ease, box-shadow 0.2s ease, -webkit-transform 0.2s ease;
	position: relative;
	overflow: hidden;
}
.action-btn.data-v-c3675ac6:active {
	-webkit-transform: scale(0.97);
	        transform: scale(0.97);
}

/* 主要CTA按钮shimmer */
.action-btn.primary.data-v-c3675ac6 {
	background: linear-gradient(135deg, #2ed573 0%, #27ae60 100%);
	color: #fff;
	box-shadow: 0 10rpx 36rpx rgba(46,213,115, 0.3);
}
.action-btn.primary.data-v-c3675ac6::after {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 25%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
	-webkit-animation: btnShimmer-data-v-c3675ac6 5s ease-in-out infinite;
	        animation: btnShimmer-data-v-c3675ac6 5s ease-in-out infinite;
}
@-webkit-keyframes btnShimmer-data-v-c3675ac6 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
@keyframes btnShimmer-data-v-c3675ac6 {
0% { left: -100%;
}
50% { left: 100%;
}
100% { left: 100%;
}
}
.action-btn.primary.data-v-c3675ac6:active {
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.2);
}
.action-btn.secondary.data-v-c3675ac6 {
	background: rgba(255, 255, 255, 0.85);
	backdrop-filter: blur(16rpx);
	-webkit-backdrop-filter: blur(16rpx);

	border: 2rpx solid rgba(46,213,115, 0.2);
	box-shadow: 0 4rpx 16rpx rgba(46,213,115, 0.06);
}

